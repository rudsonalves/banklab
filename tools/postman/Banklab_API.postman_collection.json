                      "}",
                      "if (accounts[1]) {",
                      "  pm.environment.set('account_id_2', accounts[1].id || '');",
                      "}",
                      "if (accounts.length === 1) {",
                      "  pm.environment.set('account_id_2', accounts[0].id || '');",
